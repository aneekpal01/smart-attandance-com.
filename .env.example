# Environment Configuration
PROJECT_NAME="SmartAttend-AI"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
PORT=8000
HOST="0.0.0.0"

# Database (Local SQLite for zero external dependencies)
DATABASE_URL="sqlite+aiosqlite:///./smartattend.db"

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# AI Inference Settings
FACE_DETECTION_CONFIDENCE=0.65
LIVENESS_THRESHOLD=0.75
DEVICE="cpu" # 'cpu' or 'cuda'
